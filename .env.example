# PlayCast Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/PlayCast?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Client Configuration (Optional)
CLIENT_URL=http://localhost:3000

# Author Information (Optional)
AUTHOR_NAME=Your Name
AUTHOR_EMAIL=your.email@example.com
AUTHOR_GITHUB=https://github.com/yourusername
AUTHOR_LINKEDIN=https://www.linkedin.com/in/yourprofile/